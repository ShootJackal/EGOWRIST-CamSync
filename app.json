{
  "expo": {
    "name": "EGO GoProSYNC",
    "slug": "ego-goprosync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ego-goprosync",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1117"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shootjackal.egogoprosync",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "EGO GoProSYNC connects to your GoPro cameras over Bluetooth so you can start and stop recording from your phone without any cables or a Mac.",
        "NSBluetoothPeripheralUsageDescription": "EGO GoProSYNC needs Bluetooth to discover and control your GoPro cameras.",
        "UIBackgroundModes": ["bluetooth-central"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1117"
      },
      "package": "com.shootjackal.egogoprosync",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "EGO GoProSYNC connects to your GoPro cameras over Bluetooth so you can start and stop recording from your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
