{
  "name": "ego-goprosync",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "vercel-build": "expo export --platform web",
    "build:ios": "eas build --platform ios --profile preview",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:sim": "eas build --platform ios --profile simulator",
    "build:android": "eas build --platform android --profile preview",
    "typecheck": "tsc --noEmit",
    "bridge": "cd server/bridge && npm run dev",
    "bridge:install": "cd server/bridge && npm install",
    "bridge:start": "cd server/bridge && npm start",
    "setup": "npm install && npm run bridge:install",
    "lan": "node scripts/lan.js"
  },
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.2.3",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.0",
    "expo-build-properties": "~0.14.0",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.1.4",
    "expo-linear-gradient": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.2.0",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.77.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.1",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true
}
